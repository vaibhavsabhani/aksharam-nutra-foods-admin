generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int                  @id @default(autoincrement())
  name                 String
  email                String               @unique
  passwordHash         String
  role                 UserRole             @default(ADMIN)
  status               UserStatus           @default(ACTIVE)
  isEmailVerified      Boolean              @default(false)
  emailVerifiedAt      DateTime?
  lastLoginAt          DateTime?
  lastLoginIp          String?
  passwordChangedAt    DateTime?
  passwordUpdatedById  Int?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  createdById          Int?
  updatedById          Int?
  refreshTokens        RefreshToken[]
  passwordResetTokens  PasswordResetToken[]
  blogPosts            BlogPost[]
  testimonials         Testimonial[]
  createdBy            User?                @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers         User[]               @relation("UserCreatedBy")
  updatedBy            User?                @relation("UserUpdatedBy", fields: [updatedById], references: [id])
  updatedUsers         User[]               @relation("UserUpdatedBy")
  passwordUpdatedBy    User?                @relation("PasswordUpdatedBy", fields: [passwordUpdatedById], references: [id])
  passwordUpdatedUsers User[]               @relation("PasswordUpdatedBy")

  @@index([role])
  @@index([status])
  @@index([createdAt])
  @@index([createdById])
  @@index([updatedById])
  @@index([passwordUpdatedById])
}

enum UserRole {
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model RefreshToken {
  id         Int       @id @default(autoincrement())
  tokenHash  String    @unique
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName String?
  deviceType String?
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

// PASSWORD RESET TOKEN

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

// BLOG POST MODEL

model BlogPost {
  id            Int      @id @default(autoincrement())
  title         String
  content       String   @db.Text
  coverImageUrl String?
  isShow        Boolean  @default(true)
  authorId      Int?
  author        User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  quote     String   @db.Text
  author    String
  isShow    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  Int?
  creator   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([createdAt])
}

// CONTACT INQUIRIES FROM LANDING PAGE

enum ContactStatus {
  PENDING
  CONTACTED
  RESOLVED
  ARCHIVED
}

model Contact {
  id          Int           @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String
  message     String        @db.Text
  ipAddress   String?
  city        String?
  region      String?
  country     String?
  countryCode String?
  latitude    Float?
  longitude   Float?
  status      ContactStatus @default(PENDING)
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([email])
  @@index([createdAt])
}

